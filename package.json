{
  "name": "groundwork-dental",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "checklist:sync": "mkdir -p public/checklist && cp resources/dental-online-presence-checklist.pdf public/checklist/dental-online-presence-checklist.pdf",
    "prebuild": "npm run checklist:sync",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=groundworkdental",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

---
/**
 * Motion showcase — internal, noindex, excluded from the sitemap.
 *
 * Every demo below runs on real site components (real headings, the real
 * tick list, the real comparison rows) so the choice is made against actual
 * content rather than lorem boxes. Nothing here is imported by the rest of
 * the site; deleting this file removes it entirely.
 *
 * All motion is CSS. No library, no React island.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const painPoints = [
  'Patients aren\'t finding your practice on Google or ChatGPT',
  'You\'re tired of paying monthly website fees',
  'You want a website that brings in new patients',
  'Your website feels outdated',
];

const tableRows = [
  { feature: 'Setup cost', diy: 'Free', trad: '$2,000–$15,000', gw: '$2,000 flat' },
  { feature: 'Yearly cost', diy: '$0–$200/yr', trad: '$2,400+/yr', gw: '~$12/yr' },
  { feature: 'Ownership', diy: 'Their platform', trad: 'Varies', gw: 'You own it' },
  { feature: 'Build time', diy: 'Weeks', trad: '4–12 weeks', gw: '3–7 days' },
];

const easings = [
  { id: 'expo',   label: 'ease-out-expo',  note: 'PREFERRED. Faster commit, longer tail.' },
  { id: 'quint',  label: 'ease-out-quint', note: 'Slightly softer start. Settles clean.' },
  { id: 'spring', label: 'damped spring',  note: 'Spring physics sampled into linear(). No overshoot.' },
];
---

<BaseLayout
  title="Motion showcase — internal"
  description="Internal motion options for the Groundwork Dental site."
  noindex={true}
>
  <section class="border-b border-border-light bg-surface-2">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <p class="font-sans text-xs uppercase tracking-widest text-mid-gray mb-3">Internal · not linked, not indexed</p>
      <h1 class="section-heading mb-4">Motion options</h1>
      <p class="font-serif text-mid-gray leading-relaxed max-w-2xl">
        Each option below runs on real components. Press <strong class="text-charcoal">Replay</strong> to see
        it again, or scroll away and back for the scroll-linked ones. Note which you want, per element —
        the goal is a short menu, not all of them.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">

    <!-- 1 ─────────────────────────────────────────────── fade + rise -->
    <section class="demo" data-demo="fade">
      <header class="demo-head">
        <h2 class="demo-title">1 · Fade + rise <span class="demo-tag">current default</span></h2>
        <button class="replay" data-replay="fade">Replay</button>
      </header>
      <p class="demo-note">Neutral. Reads well for prose, says nothing about the content. The problem is only that it is currently applied to everything.</p>
      <div class="demo-stage">
        <div class="anim anim-fade">
          <h3 class="font-serif text-2xl text-charcoal mb-2">Dental Websites Built for Dentists</h3>
          <p class="font-serif text-mid-gray">SEO and AI-ready, Google Business Profile included.</p>
        </div>
      </div>
    </section>

    <!-- 2 ─────────────────────────────────────────────── clip wipe -->
    <section class="demo" data-demo="wipe">
      <header class="demo-head">
        <h2 class="demo-title">2 · Clip wipe <span class="demo-tag">headings</span></h2>
        <button class="replay" data-replay="wipe">Replay</button>
      </header>
      <p class="demo-note">The type is uncovered rather than moved. Because nothing shifts position it reads settled and editorial — the closest thing to "printed" motion.</p>
      <div class="demo-stage">
        <h3 class="anim anim-wipe font-serif text-3xl text-charcoal">One price. Everything included.</h3>
        <p class="anim anim-wipe font-serif text-mid-gray mt-3" style="--d:120ms">Ready in a week, not months.</p>
      </div>
    </section>

    <!-- 3 ─────────────────────────────────────────────── tick draw -->
    <section class="demo" data-demo="tick">
      <header class="demo-head">
        <h2 class="demo-title">3 · Tick draw <span class="demo-tag">the pain-point list</span></h2>
        <button class="replay" data-replay="tick">Replay</button>
      </header>
      <p class="demo-note">Each tick draws itself, so the list checks itself off. Same technique as the success check already on /get-started. The motion says what the content says.</p>
      <div class="demo-stage">
        <ul class="space-y-3">
          {painPoints.map((item, i) => (
            <li class="anim anim-tick flex items-start gap-3" style={`--d:${i * 130}ms`}>
              <svg class="w-4 h-4 text-sage-dark shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" pathLength="1" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-serif text-charcoal leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4 ─────────────────────────────────────────────── origin-aware -->
    <section class="demo" data-demo="origin">
      <header class="demo-head">
        <h2 class="demo-title">4 · Origin-aware columns <span class="demo-tag">comparison table</span></h2>
        <button class="replay" data-replay="origin">Replay</button>
      </header>
      <p class="demo-note">Each column enters from its own side and the Groundwork column resolves last. The motion performs the argument the table is making.</p>
      <div class="demo-stage overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border-light">
              <th class="text-left py-2 font-sans text-xs uppercase tracking-widest text-mid-gray">Feature</th>
              <th class="anim anim-from-left py-2 font-sans text-xs uppercase tracking-widest text-mid-gray">DIY</th>
              <th class="anim anim-from-left py-2 font-sans text-xs uppercase tracking-widest text-mid-gray" style="--d:80ms">Agency</th>
              <th class="anim anim-from-right py-2 font-sans text-xs uppercase tracking-widest text-sage-dark bg-sage-tint" style="--d:260ms">Groundwork</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map((r, i) => (
              <tr class="border-b border-border-light">
                <td class="py-2.5 font-serif text-charcoal">{r.feature}</td>
                <td class="anim anim-from-left py-2.5 font-serif text-mid-gray text-center" style={`--d:${i * 50}ms`}>{r.diy}</td>
                <td class="anim anim-from-left py-2.5 font-serif text-mid-gray text-center" style={`--d:${i * 50 + 80}ms`}>{r.trad}</td>
                <td class="anim anim-from-right py-2.5 font-serif text-charcoal text-center bg-sage-tint" style={`--d:${i * 50 + 260}ms`}>{r.gw}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 6 ─────────────────────────────────────────────── scale + blur -->
    <section class="demo" data-demo="scale">
      <header class="demo-head">
        <h2 class="demo-title">5 · Scale + blur-to-sharp <span class="demo-tag">cards, numerals</span></h2>
        <button class="replay" data-replay="scale">Replay</button>
      </header>
      <p class="demo-note">Comes into focus rather than sliding. Works for figures because the number never moves — it just resolves. No counting.</p>
      <div class="demo-stage grid grid-cols-2 gap-8 max-w-md">
        <div class="anim anim-scale text-center">
          <p class="font-mono text-4xl text-charcoal leading-none">$2,000</p>
          <p class="font-sans text-xs uppercase tracking-widest text-mid-gray mt-2">One-time build</p>
        </div>
        <div class="anim anim-scale text-center" style="--d:110ms">
          <p class="font-mono text-4xl text-charcoal leading-none">$0</p>
          <p class="font-sans text-xs uppercase tracking-widest text-mid-gray mt-2">Per year after</p>
        </div>
      </div>
    </section>

    <!-- 7 ─────────────────────────────────────────────── scroll-linked -->
    <section class="demo">
      <header class="demo-head">
        <h2 class="demo-title">6 · Scroll-<em>linked</em> <span class="demo-tag">continuous, zero JS</span></h2>
        <span class="demo-hint">scroll slowly ↕</span>
      </header>
      <p class="demo-note">
        Everything above is scroll-<em>triggered</em>: it fires once and finishes. This is tied to scroll
        position, so it moves with you and reverses when you scroll back. Pure CSS
        (<code>animation-timeline</code>), no JavaScript at all.
      </p>
      <div class="demo-stage">
        <div class="scroll-demo">
          <div class="scroll-demo__bar"></div>
          <p class="font-serif text-charcoal">This block's tint and offset track your scroll position.</p>
          <p class="font-serif text-sm text-mid-gray mt-1">Nothing "fires" — there is no before and after, only position.</p>
        </div>
        <p class="font-serif text-xs text-mid-gray mt-3" id="sd-support"></p>
      </div>
    </section>

    <!-- 8 ─────────────────────────────────────────────── hover -->
    <section class="demo">
      <header class="demo-head">
        <h2 class="demo-title">7 · Hover <span class="demo-tag">hover these</span></h2>
        <span class="demo-hint">point at them ↓</span>
      </header>
      <p class="demo-note">Today every hover on the site is a colour change (43 of them). These cost nothing and carry more character.</p>
      <div class="demo-stage space-y-5">
        <p><a href="#" class="hv-arrow font-sans text-sm text-sage-dark">See an example <span class="hv-arrow__i">→</span></a></p>
        <div class="grid sm:grid-cols-2 gap-4 max-w-lg">
          <div class="hv-lift card">
            <p class="font-serif text-charcoal">Card lift</p>
            <p class="font-serif text-sm text-mid-gray">Rises 2px, border warms to sage.</p>
          </div>
          <div class="hv-tint card">
            <p class="font-serif text-charcoal">Surface warm</p>
            <p class="font-serif text-sm text-mid-gray">Background shifts to sage-tint. No lines.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 9 ─────────────────────────────────────────────── easing -->
    <section class="demo" data-demo="ease">
      <header class="demo-head">
        <h2 class="demo-title">8 · Easing, same distance <span class="demo-tag">the character dial</span></h2>
        <button class="replay" data-replay="ease">Replay</button>
      </header>
      <p class="demo-note">The three approved curves, same distance. ease-out-expo is the default; the others are here for cases where it feels too quick.</p>
      <div class="demo-stage space-y-3">
        {easings.map((e) => (
          <div class="ease-row">
            <span class="ease-label font-sans text-xs text-mid-gray">{e.label}</span>
            <span class="ease-track"><span class={`ease-dot ease-${e.id}`}></span></span>
            <span class="font-serif text-xs text-mid-gray">{e.note}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 9 ─────────────────────────────────────────── page transition -->
    <section class="demo">
      <header class="demo-head">
        <h2 class="demo-title">9 · Page transition <span class="demo-tag">between pages</span></h2>
        <span class="demo-hint">click a link ↓</span>
      </header>
      <p class="demo-note">
        Not a shared element — the whole page. The outgoing page fades, the incoming one fades and
        rises 8px. The header is pinned so it does not flicker while the content swaps. This is the
        router that is already installed; the only change is the curve and duration.
      </p>
      <div class="demo-stage flex flex-wrap gap-3">
        <a href="/pricing" class="btn-secondary">Pricing</a>
        <a href="/how-it-works" class="btn-secondary">How it works</a>
        <a href="/about" class="btn-secondary">About</a>
        <a href="/motion" class="btn-primary">Back here</a>
      </div>
    </section>

    <!-- 10 ──────────────────────────────── already shipped, for completeness -->
    <section class="demo">
      <header class="demo-head">
        <h2 class="demo-title">10 · Already on the site <span class="demo-tag">not proposals — these ship today</span></h2>
      </header>
      <p class="demo-note">
        Everything above is a choice to make. These are already live, and were missing from this page,
        so the menu was not actually a full inventory. Interact with them the same way.
      </p>

      <div class="demo-stage space-y-8">
        <div>
          <p class="shipped-label">FAQ accordion · <code>grid-template-rows</code> 220ms</p>
          <details class="ship-faq">
            <summary class="font-serif text-charcoal cursor-pointer py-3">What do I actually own after the build?</summary>
            <div class="ship-faq__panel">
              <p class="font-serif text-mid-gray pb-3">Everything. Domain, content, hosting account, code repository, and your Google accounts.</p>
            </div>
          </details>
          <p class="demo-note mt-1">Animating height without a fixed value. The chevron rotate is part of the same interaction.</p>
        </div>

        <div>
          <p class="shipped-label">Form label swap · blur, 150ms</p>
          <button class="btn-primary" id="ship-submit"><span class="ship-swap" data-label>Build My Free Preview</span></button>
          <p class="demo-note mt-2">Old label leaves upward and blurs, new one arrives from below. Live on /get-started.</p>
        </div>

        <div>
          <p class="shipped-label">Success check · SVG stroke draw, 420ms</p>
          <div class="flex items-center gap-4">
            <span class="ship-check w-14 h-14 rounded-full bg-sage/20 flex items-center justify-center" data-state="out">
              <svg class="w-7 h-7 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" pathLength="1" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <button class="replay" id="ship-check-replay">Replay</button>
          </div>
          <p class="demo-note mt-2">Same technique as §3. This one is the real thing, on form submit.</p>
        </div>

        <div>
          <p class="shipped-label">Button press · 1px translate</p>
          <button class="btn-primary">Press and hold me</button>
          <p class="demo-note mt-2">Every button already does this on <code>:active</code>.</p>
        </div>

        <div>
          <p class="shipped-label">Animated gradient field · WebGL, 1.6KB</p>
          <p class="demo-note mt-1">
            Not reproducible in a box — it is the drifting sage field behind every <code>surface-2</code>
            band. Scroll this page's own header, or any tinted section on the site.
          </p>
        </div>

        <div>
          <p class="shipped-label">Header dropdown · opacity + 2px translate, 150ms</p>
          <p class="demo-note mt-1">Hover "How it works" in the nav above.</p>
        </div>
      </div>
    </section>

    <section class="demo">
      <h2 class="demo-title mb-3">Not shown, and why</h2>
      <ul class="font-serif text-mid-gray text-sm space-y-2 max-w-2xl">
        <li>— <strong class="text-charcoal">Counting numerals.</strong> Your voice guide says state the number, don't perform it.</li>
        <li>— <strong class="text-charcoal">Card tilt / 3D.</strong> The generic-AI look the design system is positioned against.</li>
        <li>— <strong class="text-charcoal">Parallax on text.</strong> Hurts readability and LCP.</li>
        <li>— <strong class="text-charcoal">Overshoot and linear.</strong> Removed from the menu entirely.</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .demo { scroll-margin-top: 6rem; }

  .demo-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid theme('colors.border-light');
    padding-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .demo-title {
    @apply font-serif text-xl text-charcoal;
  }

  .demo-tag {
    @apply font-sans text-xs uppercase tracking-widest text-mid-gray;
    margin-left: 0.5rem;
  }

  .demo-hint {
    @apply font-sans text-xs uppercase tracking-widest text-sage-dark;
    white-space: nowrap;
  }

  .demo-note {
    @apply font-serif text-sm text-mid-gray leading-relaxed;
    max-width: 46rem;
    margin-bottom: 1.25rem;
  }

  .demo-stage {
    @apply rounded border border-border-light bg-surface-1 p-6 md:p-8;
  }

  .replay {
    @apply font-sans text-xs uppercase tracking-widest text-sage-dark border border-border-light rounded px-3 py-1.5;
    white-space: nowrap;
    transition: border-color 200ms, color 200ms;
  }
  .replay:hover { border-color: theme('colors.sage-dark'); color: theme('colors.charcoal'); }

  /* ── Entrance treatments ───────────────────────────────────────────── */
  /* `.is-out` is the resting hidden state; removing it plays the motion. */

  .anim { --d: 0ms; }

  .anim-fade.is-out { opacity: 0; transform: translateY(10px); }
  .anim-fade {
    transition: opacity 450ms ease-out var(--d),
                transform 450ms cubic-bezier(0.22, 1, 0.36, 1) var(--d);
  }

  .anim-wipe.is-out { opacity: 0; clip-path: inset(0 100% 0 0); }
  .anim-wipe {
    clip-path: inset(0 0 0 0);
    transition: opacity 200ms linear var(--d),
                clip-path 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--d);
  }

  .anim-tick.is-out { opacity: 0; }
  .anim-tick { transition: opacity 260ms ease-out var(--d); }
  .anim-tick path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .anim-tick.is-out path { stroke-dashoffset: 1; }
  .anim-tick path {
    transition: stroke-dashoffset 420ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--d) + 120ms);
  }

  .anim-from-left.is-out  { opacity: 0; transform: translateX(-14px); }
  .anim-from-right.is-out { opacity: 0; transform: translateX(14px); }
  .anim-from-left, .anim-from-right {
    transition: opacity 400ms ease-out var(--d),
                transform 500ms cubic-bezier(0.22, 1, 0.36, 1) var(--d);
  }

  .anim-scale.is-out { opacity: 0; transform: scale(0.96); filter: blur(6px); }
  .anim-scale {
    transition: opacity 400ms ease-out var(--d),
                transform 550ms cubic-bezier(0.22, 1, 0.36, 1) var(--d),
                filter 450ms ease-out var(--d);
  }

  /* ── Scroll-linked ─────────────────────────────────────────────────── */
  .scroll-demo {
    position: relative;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    border-radius: 4px;
    background: theme('colors.surface.2');
  }

  .scroll-demo__bar {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: theme('colors.sage');
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    .scroll-demo {
      animation: sd-tint linear both;
      animation-timeline: view();
      animation-range: entry 10% exit 90%;
    }
    .scroll-demo__bar {
      animation: sd-bar linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }
  }

  @keyframes sd-tint {
    0%   { background: theme('colors.surface.2'); transform: translateY(8px); }
    50%  { background: theme('colors.sage-tint'); transform: translateY(0); }
    100% { background: theme('colors.surface.2'); transform: translateY(-8px); }
  }

  @keyframes sd-bar {
    0%   { transform: scaleY(0); }
    100% { transform: scaleY(1); }
  }

  /* ── Hover ─────────────────────────────────────────────────────────── */
  .hv-arrow { text-decoration: none; }
  .hv-arrow__i {
    display: inline-block;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hv-arrow:hover .hv-arrow__i { transform: translateX(5px); }

  .hv-lift {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 260ms ease-out;
  }
  .hv-lift:hover {
    transform: translateY(-2px);
    border-color: theme('colors.sage');
  }

  .hv-tint { transition: background-color 260ms ease-out; }
  .hv-tint:hover { background-color: theme('colors.sage-tint'); }

  .shipped-label {
    @apply font-sans text-xs uppercase tracking-widest text-mid-gray mb-2;
  }

  .ship-faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ship-faq[open] .ship-faq__panel { grid-template-rows: 1fr; }
  .ship-faq__panel > * { overflow: hidden; }

  .ship-swap {
    display: inline-block;
    transition: opacity 150ms ease-in-out, transform 150ms ease-in-out, filter 150ms ease-in-out;
  }
  .ship-swap.is-exit { opacity: 0; transform: translateY(-4px); filter: blur(2px); }
  .ship-swap.is-enter { opacity: 0; transform: translateY(4px); filter: blur(2px); transition: none; }

  .ship-check { opacity: 0; transform: translateY(6px) scale(0.94); }
  .ship-check[data-state='in'] {
    opacity: 1; transform: none;
    transition: opacity 260ms ease-out, transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ship-check path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .ship-check[data-state='in'] path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms cubic-bezier(0.65, 0, 0.35, 1) 120ms;
  }

  /* ── Easing comparison ─────────────────────────────────────────────── */
  .ease-row {
    display: grid;
    grid-template-columns: 9rem 1fr 1fr;
    align-items: center;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .ease-row { grid-template-columns: 7rem 1fr; }
    .ease-row > :last-child { display: none; }
  }

  .ease-track {
    position: relative;
    display: block;
    height: 10px;
    border-bottom: 1px dashed theme('colors.border-light');
  }

  .ease-dot {
    position: absolute;
    left: 0; top: 0;
    width: 10px; height: 10px;
    border-radius: 999px;
    background: theme('colors.sage-dark');
    transform: translateX(calc(100cqw - 10px));
  }

  .ease-track { container-type: inline-size; }
  .is-out .ease-dot, .ease-row.is-out .ease-dot { transform: translateX(0); }

  .ease-quint     { transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1); }
  .ease-expo      { transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1); }
  /* A critically damped spring, sampled into linear(). No overshoot. */
  .ease-spring    { transition: transform 900ms linear(0, 0.06, 0.22, 0.44, 0.66, 0.82, 0.92, 0.97, 0.99, 1); }

  /*
   * Applied for one frame while the demo is reset. Without it, adding the
   * hidden class TRANSITIONS toward hidden, and replaying 60ms later catches
   * it ~13% of the way there — which reads as a jitter, not an animation.
   */
  .no-anim, .no-anim *, .no-anim *::after {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .anim, .anim::after, .ease-dot, .hv-arrow__i, .hv-lift, .hv-tint, .scroll-demo, .scroll-demo__bar {
      transition: none !important;
      animation: none !important;
    }
    .anim.is-out { opacity: 1 !important; transform: none !important; filter: none !important; clip-path: none !important; }
    .anim.is-out path { stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  /**
   * Demo harness. Puts each group into its hidden state, then plays it when
   * it scrolls into view, and again on Replay. Showcase-only — the real site
   * uses the reveal system in BaseLayout.
   */
  const groups = () => document.querySelectorAll<HTMLElement>('[data-demo]');

  const targets = (scope: HTMLElement) =>
    scope.querySelectorAll<HTMLElement>('.anim, .ease-row');

  /** Snap to the hidden state with transitions off, so nothing animates out. */
  function setOut(scope: HTMLElement) {
    scope.classList.add('no-anim');
    targets(scope).forEach((el) => el.classList.add('is-out'));
    void scope.offsetWidth;        // commit the hidden state to this frame
    scope.classList.remove('no-anim');
  }

  function play(scope: HTMLElement) {
    void scope.offsetWidth;        // ...and commit the removal of .no-anim
    targets(scope).forEach((el) => el.classList.remove('is-out'));
  }

  function init() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    groups().forEach(setOut);

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            play(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -20% 0px', threshold: 0 }
    );
    groups().forEach((g) => io.observe(g));

    document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const scope = document.querySelector<HTMLElement>(`[data-demo="${btn.dataset.replay}"]`);
        if (!scope) return;
        setOut(scope);
        // One frame is enough now that the reset is instant; a longer wait
        // just looks like lag before the replay starts.
        requestAnimationFrame(() => requestAnimationFrame(() => play(scope)));
      });
    });

    // Shipped-behaviour demos
    const swap = document.querySelector<HTMLElement>('.ship-swap');
    document.getElementById('ship-submit')?.addEventListener('click', () => {
      if (!swap) return;
      const next = swap.textContent?.trim() === 'Sending...' ? 'Build My Free Preview' : 'Sending...';
      swap.classList.add('is-exit');
      window.setTimeout(() => {
        swap.textContent = next;
        swap.classList.remove('is-exit');
        swap.classList.add('is-enter');
        void swap.offsetWidth;
        swap.classList.remove('is-enter');
      }, 150);
    });

    const check = document.querySelector<HTMLElement>('.ship-check');
    document.getElementById('ship-check-replay')?.addEventListener('click', () => {
      if (!check) return;
      check.dataset.state = 'out';
      requestAnimationFrame(() => requestAnimationFrame(() => { check.dataset.state = 'in'; }));
    });

    const note = document.getElementById('sd-support');
    if (note) {
      note.textContent = CSS.supports('animation-timeline', 'view()')
        ? 'Your browser supports scroll-linked CSS — the block above is tracking your scroll position.'
        : 'Your browser does not support animation-timeline, so the block above is static. That is the fallback.';
    }
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import GradientBackdrop from '../components/GradientBackdrop.astro';
---

<BaseLayout
  title="Get Started — Groundwork Dental"
  description="We build a real preview of your new dental website before you pay. See it first — if you want it, it's $2,000 flat. If not, you owe nothing."
>
  <!-- Hero -->
  <section class="relative isolate bg-surface-2">
    <GradientBackdrop intensity={0.55} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="section-heading mb-6">See Your New Website Before You Pay.</h1>
        <p class="font-serif text-xl text-mid-gray leading-relaxed">
          Send your practice name and current site. We'll build a real preview — not a mockup —
          and send you the link. If you want it, it's $2,000. If not, you owe nothing.
        </p>
        <p class="mt-5 font-serif text-base text-mid-gray">
          <a href="/example" class="text-sage-dark underline underline-offset-4 hover:text-charcoal">
            See an example of what we build
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="py-10">
    <div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8">
      <form id="get-started-form" class="space-y-6">
        <div>
          <label for="name" class="block font-sans text-xs uppercase tracking-widest text-mid-gray mb-2">
            Your Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Dr. Sarah Smith"
            class="w-full px-4 py-3 border border-border-light rounded font-serif text-charcoal placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sage focus:border-transparent"
          />
        </div>

        <div>
          <label for="email" class="block font-sans text-xs uppercase tracking-widest text-mid-gray mb-2">
            Your Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="doctor@yourpractice.com"
            class="w-full px-4 py-3 border border-border-light rounded font-serif text-charcoal placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sage focus:border-transparent"
          />
        </div>

        <div>
          <label for="website" class="block font-sans text-xs uppercase tracking-widest text-mid-gray mb-2">
            Current Website URL <span class="text-neutral-400">(if you have one)</span>
          </label>
          <input
            type="text"
            id="website"
            name="website"
            placeholder="https://yourdentalpractice.com"
            class="w-full px-4 py-3 border border-border-light rounded font-serif text-charcoal placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sage focus:border-transparent"
          />
        </div>

        <div>
          <label for="comment" class="block font-sans text-xs uppercase tracking-widest text-mid-gray mb-2">
            Anything else we should know? <span class="text-neutral-400">(optional — one line is fine)</span>
          </label>
          <textarea
            id="comment"
            name="comment"
            rows="4"
            placeholder="Tell us about your practice, what services you offer, or what you're looking for in a website..."
            class="w-full px-4 py-3 border border-border-light rounded font-serif text-charcoal placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sage focus:border-transparent resize-y"
          ></textarea>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full btn-primary py-3.5 text-center"
        >
          <span class="text-swap" data-label>Build My Free Preview</span>
        </button>

        <p class="text-center font-serif text-sm text-mid-gray">
          No payment, no commitment. We build the preview first — you decide after you've seen it.
        </p>

        <p class="text-center font-serif text-sm text-mid-gray">
          Not ready?
          <a href="/checklist" class="text-sage-dark underline underline-offset-4 hover:text-charcoal">
            Grab the free online presence checklist
          </a>
          instead.
        </p>
      </form>

      <!-- Success State -->
      <div id="form-success" class="hidden text-center py-8">
        <div class="success-check w-16 h-16 rounded-full bg-sage/20 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" pathLength="1" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="font-serif text-2xl text-charcoal mb-4">Got it — we'll start on your preview.</h2>
        <p class="font-serif text-mid-gray leading-relaxed mb-2">
          We'll build your preview and send you the link. No payment until you've seen it.
        </p>
        <p class="font-serif text-sm text-mid-gray">
          In the meantime, take a look at our <a href="/example" class="text-sage-dark hover:text-sage-dark underline">example site</a>.
        </p>
      </div>

      <!-- Error State -->
      <div id="form-error" class="error-reveal hidden mt-4 p-4 bg-red-50 border border-red-200 rounded text-center" role="alert">
        <p class="font-serif text-sm text-red-700">
          Something went wrong. Please email us directly at <a href={`mailto:${site.email}`} class="underline">{site.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="py-8 relative isolate bg-surface-2">
    <GradientBackdrop intensity={0.55} />
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div>
          <p class="font-serif text-charcoal font-semibold mb-1">No payment upfront</p>
          <p class="font-serif text-sm text-mid-gray">You see a live preview first. Pay $2,000 when you want it — it can go live on your domain that day.</p>
        </div>
        <div>
          <p class="font-serif text-charcoal font-semibold mb-1">You own everything</p>
          <p class="font-serif text-sm text-mid-gray">Code, hosting, domain, analytics. All yours.</p>
        </div>
        <div>
          <p class="font-serif text-charcoal font-semibold mb-1">~$12/year after</p>
          <p class="font-serif text-sm text-mid-gray">Domain renewal paid to your registrar — not us. Hosting should be free.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * Three transitions on the one page that actually changes state. Durations
   * are deliberately short — this is a confirmation, not a celebration.
   */

  /* --- Success check -------------------------------------------------- */
  /* The circle settles up into place while the tick draws itself. */
  .success-check {
    opacity: 0;
    transform: translateY(6px) scale(0.94);
  }

  .success-check[data-state='in'] {
    opacity: 1;
    transform: none;
    transition:
      opacity 260ms ease-out,
      transform 420ms cubic-bezier(0.22, 1.2, 0.36, 1); /* slight overshoot */
  }

  /* pathLength="1" on the <path> normalises the stroke, so the draw is a
     single 0..1 tween no matter what the real path length is. */
  .success-check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .success-check[data-state='in'] path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms cubic-bezier(0.65, 0, 0.35, 1) 120ms;
  }

  /* --- Button label swap ---------------------------------------------- */
  .text-swap {
    display: inline-block;
    transition:
      opacity 150ms ease-in-out,
      transform 150ms ease-in-out,
      filter 150ms ease-in-out;
  }

  /* Old label leaves upward; the new one is placed below, then released. */
  .text-swap.is-exit {
    opacity: 0;
    transform: translateY(-4px);
    filter: blur(2px);
  }

  .text-swap.is-enter {
    opacity: 0;
    transform: translateY(4px);
    filter: blur(2px);
    transition: none;
  }

  /* --- Error reveal ---------------------------------------------------- */
  /* No shake: a failed POST is our fault, and shaking the form implies the
     reader typed something wrong. It just needs to arrive noticeably. */
  .error-reveal {
    opacity: 0;
    transform: translateY(-4px);
  }

  .error-reveal[data-state='in'] {
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms ease-out,
      transform 200ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .success-check,
    .success-check[data-state='in'],
    .success-check path,
    .success-check[data-state='in'] path,
    .text-swap,
    .text-swap.is-exit,
    .text-swap.is-enter,
    .error-reveal,
    .error-reveal[data-state='in'] {
      opacity: 1;
      transform: none;
      filter: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  const form = document.getElementById('get-started-form') as HTMLFormElement;
  const successDiv = document.getElementById('form-success');
  const errorDiv = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnLabel = submitBtn?.querySelector<HTMLElement>('[data-label]');

  const DUR = 150; // keep in step with .text-swap's transition

  /**
   * Swaps a label's text in place: the old one leaves upward, the new one
   * arrives from below. Falls back to a plain assignment when the reader has
   * asked for reduced motion, so the label never sits mid-animation.
   */
  function swapLabel(el: HTMLElement | null | undefined, next: string) {
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = next;
      return;
    }
    el.classList.add('is-exit');
    window.setTimeout(() => {
      el.textContent = next;
      el.classList.remove('is-exit');
      el.classList.add('is-enter');
      // Force a reflow so the browser paints the "below" position before the
      // class is dropped; without this the enter tween is skipped entirely.
      void el.offsetWidth;
      el.classList.remove('is-enter');
    }, DUR);
  }

  /** Reveals a hidden block and lets its transition run from the start. */
  function reveal(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('hidden');
    void el.offsetWidth;
    el.dataset.state = 'in';
  }

  // Fired once, on the first keystroke in any field.
  //
  // This is the half of the funnel that distinguishes the two failure modes:
  // if nobody starts, the offer or the copy is wrong; if they start and never
  // submit, the form is. Without it, "no submissions" is unreadable.
  let started = false;
  form?.addEventListener('input', () => {
    if (started) return;
    started = true;
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'lead_form_start', { page_path: window.location.pathname });
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Disable button and show loading state
    submitBtn.disabled = true;
    swapLabel(btnLabel, 'Sending...');
    errorDiv?.classList.add('hidden');
    if (errorDiv) delete errorDiv.dataset.state;

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      website: formData.get('website') || '',
      comment: formData.get('comment') || '',
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      // Record the conversion only after the request actually succeeded.
      // Firing on click would count failures as conversions and quietly
      // inflate the one number the funnel is judged on.
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'lead_submit', {
          page_path: window.location.pathname,
          has_website: Boolean(data.website),
          has_comment: Boolean(data.comment),
        });
      }

      // Show success, hide form
      form.classList.add('hidden');
      successDiv?.classList.remove('hidden');
      // The check draws itself once the block is in the layout.
      const check = successDiv?.querySelector<HTMLElement>('.success-check');
      if (check) { void check.offsetWidth; check.dataset.state = 'in'; }
    } catch (err) {
      // A failed submission is a lost lead, and it is invisible unless it is
      // recorded. If submits and failures both climb, the problem is the
      // endpoint, not the copy.
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'lead_submit_failed', {
          page_path: window.location.pathname,
        });
      }
      console.error('Form submission failed:', err);
      reveal(errorDiv);
      submitBtn.disabled = false;
      swapLabel(btnLabel, 'Build My Free Preview');
    }
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABlock from '../../components/CTABlock.astro';
import { site } from '../../config/site';

const inviteEmail = site.email;
---

<BaseLayout
  title="Account Setup — Cloudflare & GitHub | Groundwork Dental"
  description="One-time Cloudflare and GitHub checklist: do it live on Zoom, or create the accounts yourself and invite Groundwork as admin."
  noindex={false}
>
  <section class="bg-surface-2">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
      <div class="max-w-3xl">
        <p class="eyebrow text-sage-dark mb-4">Client checklist</p>
        <h1 class="section-heading mb-6">Account setup: Cloudflare &amp; GitHub</h1>
        <p class="font-serif text-xl text-mid-gray leading-relaxed">
          You own the accounts. We build in them. You can remove our access anytime.
          One-time setup — about 15 minutes. Pick an option and work through the checklist.
        </p>
        <p class="font-sans text-sm text-mid-gray mt-6">
          Prefer markdown?
          <a href="/guides/account-setup.md" class="text-sage-dark hover:underline">Download / copy the .md</a>
        </p>
      </div>
    </div>
  </section>

  <section class="py-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <!-- Before you start -->
      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-4">Before you start</h2>
        <ul class="space-y-3 font-serif text-lg text-charcoal">
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Have a practice email ready (e.g. <code class="text-base">front@yourpractice.com</code>)</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Have about 15 minutes</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Know where your domain is registered (GoDaddy, Google, Namecheap, Wix, etc.)</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span><strong>Do not change DNS or nameservers yet</strong> — that can break office email</span></li>
        </ul>
      </div>

      <!-- Choose one -->
      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-4">Choose one</h2>
        <div class="grid gap-4 sm:grid-cols-2 mb-4">
          <div class="border border-neutral-200 bg-surface-2 rounded-lg p-5">
            <p class="font-sans text-xs uppercase tracking-wider text-sage-dark mb-2">Option 1</p>
            <h3 class="font-serif text-xl text-charcoal mb-2">Live on Zoom</h3>
            <p class="font-serif text-mid-gray leading-relaxed">
              We drive on a shared screen. You verify email and set passwords.
            </p>
          </div>
          <div class="border border-neutral-200 bg-surface-2 rounded-lg p-5">
            <p class="font-sans text-xs uppercase tracking-wider text-sage-dark mb-2">Option 2</p>
            <h3 class="font-serif text-xl text-charcoal mb-2">You set up, invite us</h3>
            <p class="font-serif text-mid-gray leading-relaxed">
              You create Cloudflare + GitHub, then invite Groundwork as admin.
            </p>
          </div>
        </div>
        <p class="font-serif text-mid-gray leading-relaxed">
          Same result either way: accounts in your name, we can build and deploy, you can remove us anytime.
        </p>
      </div>

      <!-- Option 1 -->
      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-4">Option 1 checklist — Zoom</h2>
        <ul class="space-y-3 font-serif text-lg text-charcoal">
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Reply on your project thread asking for a Zoom setup</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Join the call with your practice email inbox open</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Verify the Cloudflare and GitHub emails when they arrive</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Set passwords and save them somewhere safe</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Tell us where the domain is registered and whether you can log in</span></li>
        </ul>
        <p class="font-serif text-mid-gray mt-4 leading-relaxed">
          We’ll handle the rest (admin invites, site connection, DNS at go-live).
        </p>
      </div>

      <!-- Option 2 -->
      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-6">Option 2 checklist — Do it yourself</h2>

        <h3 class="font-serif text-xl text-charcoal mb-3">Cloudflare</h3>
        <ul class="space-y-3 font-serif text-lg text-charcoal mb-8">
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Go to <a href="https://dash.cloudflare.com/sign-up" target="_blank" rel="noopener" class="text-sage-dark hover:underline">dash.cloudflare.com/sign-up</a></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Sign up with your <strong>practice email</strong></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Verify the email and set a password (Free plan)</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Open <strong>Manage Account</strong> → <strong>Members</strong> → <strong>Invite</strong></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Invite <code class="text-base">{inviteEmail}</code> as <strong>Administrator</strong></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Send the invite</span></li>
        </ul>

        <h3 class="font-serif text-xl text-charcoal mb-3">GitHub</h3>
        <ul class="space-y-3 font-serif text-lg text-charcoal mb-8">
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Go to <a href="https://github.com/signup" target="_blank" rel="noopener" class="text-sage-dark hover:underline">github.com/signup</a></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Sign up with the <strong>same practice email</strong> when possible</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Verify the email and set a password (Free plan)</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>When we send your repo link: <strong>Settings</strong> → <strong>Collaborators</strong> → <strong>Add people</strong></span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Invite <code class="text-base">{inviteEmail}</code> (or the username we send) with <strong>Write</strong> or <strong>Admin</strong></span></li>
        </ul>

        <h3 class="font-serif text-xl text-charcoal mb-3">Domain</h3>
        <ul class="space-y-3 font-serif text-lg text-charcoal">
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Note where the domain is registered</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Confirm you can log in to that account</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Reply on your project thread when Cloudflare + GitHub invites are sent</span></li>
          <li class="flex gap-3"><span class="mt-1 shrink-0 w-5 h-5 border border-charcoal/40 rounded-sm" aria-hidden="true"></span><span>Leave DNS / nameservers alone until we say otherwise</span></li>
        </ul>
      </div>

      <!-- After setup -->
      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-4">After setup — we handle this</h2>
        <ul class="space-y-3 font-serif text-lg text-mid-gray">
          <li class="flex gap-3"><span class="text-sage-dark shrink-0" aria-hidden="true">→</span><span>Preview stays on a temporary URL until go-live</span></li>
          <li class="flex gap-3"><span class="text-sage-dark shrink-0" aria-hidden="true">→</span><span>We connect the site in <strong class="text-charcoal">your</strong> Cloudflare account</span></li>
          <li class="flex gap-3"><span class="text-sage-dark shrink-0" aria-hidden="true">→</span><span>We copy DNS (especially email / MX), then point the real domain</span></li>
          <li class="flex gap-3"><span class="text-sage-dark shrink-0" aria-hidden="true">→</span><span>You get a handoff doc with every login</span></li>
        </ul>
        <p class="font-serif text-mid-gray mt-4 leading-relaxed">
          After launch, your only required cost is domain renewal (~$12–15/year). Hosting stays free.
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl text-charcoal mb-3">Questions</h2>
        <p class="font-serif text-lg text-mid-gray leading-relaxed">
          Email <a href={`mailto:${inviteEmail}`} class="text-sage-dark hover:underline">{inviteEmail}</a> — or reply on your project thread.
        </p>
      </div>

    </div>
  </section>

  <CTABlock
    heading="Ready when you are"
    subheading="Pick Option 1 or Option 2 and work the checklist. Same result either way — about 15 minutes, one time."
    primaryCTA="Get Started"
    primaryHref="/get-started"
    secondaryCTA="How It Works"
    secondaryHref="/how-it-works"
  />
</BaseLayout>

---
/**
 * The account-handoff walkthrough, served at /account-handoff.
 *
 * Linked from the paid-in-full email to every client, not built per-client.
 * It exists because the same four accounts (GitHub, Cloudflare, GA4, Search
 * Console) come up on every handoff, and most practices have never created
 * any of them — walking each one through it by hand in an email thread does
 * not scale past a handful of clients.
 *
 * Kept deliberately terse: one action per step, everything else collapsed
 * behind "More info" so a non-technical reader sees five short instructions,
 * not five walls of text. The <details> element does this with no JS and
 * degrades to plain expandable text if styles fail to load.
 *
 * GBP is deliberately NOT a "create an account" step here: every practice
 * already has a Business Profile (Google creates one from Maps/search
 * activity whether you asked for it or not) — the client-owned step is
 * granting Groundwork Manager access to the existing listing, not making a
 * new one.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQBlock from '../components/FAQBlock.astro';
import CTABlock from '../components/CTABlock.astro';
import GradientBackdrop from '../components/GradientBackdrop.astro';

const steps = [
  {
    n: '1',
    id: 'step-1',
    title: 'Create a GitHub account',
    action: 'Holds your website\'s code.',
    link: { href: 'https://github.com/signup', label: 'Create GitHub account' },
    essential: 'When you\'re done, send us your username — it\'s in the URL, right after github.com/ (like github.com/your-username).',
    edge: {
      summary: 'More than one person needs access?',
      body: 'Create a free GitHub Organization instead of a personal account — Settings → "New organization" — so access survives any one person leaving.',
    },
  },
  {
    n: '2',
    id: 'step-2',
    title: 'Create a Cloudflare account',
    action: 'Hosts your site and its DNS.',
    link: { href: 'https://dash.cloudflare.com/sign-up', label: 'Create Cloudflare account' },
    essential: 'Add hello@groundworkdental.com as an Administrator (Manage Account → Members → Invite).',
    edge: {
      summary: 'Already have Cloudflare from a previous developer or MSP?',
      body: 'Use that account instead of creating a new one — a second account just splits your DNS across two places. Add hello@groundworkdental.com there instead. (Your domain\'s registrar — where you renew it each year — can be a completely different company. That\'s normal and doesn\'t need to change.)',
    },
  },
  {
    n: '3',
    id: 'step-3',
    title: 'Create a Google Analytics (GA4) property',
    action: 'Tracks who visits your site.',
    link: { href: 'https://analytics.google.com', label: 'Open Google Analytics' },
    essential: 'Create it in your own Google account, add hello@groundworkdental.com as Administrator, then send us the Measurement ID — find it under Admin → Data Streams → your stream, it starts with "G-".',
    edge: null,
  },
  {
    n: '4',
    id: 'step-4',
    title: 'Verify your domain in Search Console',
    action: 'Shows if Google can find your pages.',
    link: { href: 'https://search.google.com/search-console', label: 'Open Search Console' },
    essential: 'Choose "Domain" as the property type, then add hello@groundworkdental.com as a user once verified.',
    edge: {
      summary: 'Already have Groundwork managing your DNS?',
      body: 'Verification needs one DNS TXT record. Send us the value Google gives you and we\'ll add it for you.',
    },
  },
  {
    n: '5',
    id: 'step-5',
    title: 'Add us as a Manager on your Business Profile',
    action: 'Where your Google listing lives.',
    link: { href: 'https://business.google.com', label: 'Open Business Profile' },
    essential: 'Add hello@groundworkdental.com as a Manager (not Owner — you keep Owner) under People and access.',
    edge: {
      summary: 'Why does this take a while?',
      body: 'Google\'s approval on our end can take days to weeks, so the earlier this happens, the better — it does not block your site from being live.',
    },
  },
];

const faqs = [
  {
    question: 'Why create these myself instead of Groundwork setting them up?',
    answer: 'Ownership. If we create them under our identity, ending the relationship later means migrating your data to a new owner. Starting them under your own accounts means nothing ever has to move.',
  },
  {
    question: 'What if I already have some of these?',
    answer: 'Use what you already have — a second GA4 property or Search Console verification for the same domain just splits your data. Send us access to the existing one instead.',
  },
  {
    question: 'Do I need to finish all five before my site goes live?',
    answer: 'No. GitHub and Cloudflare come first, since that\'s where your site lives. The rest can follow shortly after.',
  },
  {
    question: 'I\'m not technical — can someone else do this?',
    answer: 'Yes. An office manager or trusted contact can handle any of these — the only requirement is that the account belongs to the practice, not one person who might leave.',
  },
];
---

<BaseLayout
  title="Account Handoff Guide | Groundwork Dental"
  description="Five short steps to set up the accounts your practice needs to own — GitHub, Cloudflare, GA4, Search Console, and Google Business Profile."
>
  <section class="relative isolate bg-surface-2">
    <GradientBackdrop intensity={0.68} />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      <h1 class="section-heading mb-4">Setting Up Your Accounts</h1>
      <p class="font-serif text-lg text-mid-gray leading-relaxed mb-3">
        Five accounts below. For each one: create or verify it, then add <span class="text-charcoal font-medium">hello@groundworkdental.com</span> so we can help manage it.
      </p>
      <p class="font-serif text-lg text-mid-gray leading-relaxed">
        All five are free, they belong to you, and you'll rarely need to open any of them again. Each step takes a couple minutes — tap the arrow only if you want more detail.
      </p>
    </div>
  </section>

  <section class="reveal py-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {steps.map((step) => (
        <div id={step.id} class="border border-hairline rounded-lg p-5 md:p-6 scroll-mt-24">
          <div class="flex items-start gap-4">
            <span class="flex-none w-9 h-9 rounded-full bg-sage-dark text-white flex items-center justify-center font-serif text-base">
              {step.n}
            </span>
            <div class="flex-1 min-w-0">
              <h2 class="text-xl font-serif text-charcoal mb-1">{step.title}</h2>
              <p class="text-mid-gray mb-2">{step.action}</p>
              <p class="text-sm text-charcoal font-medium mb-4">{step.essential}</p>

              <a
                href={step.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-sage-dark text-white hover:bg-sage-darker font-sans font-medium text-sm px-5 py-2.5 rounded transition-colors"
              >
                {step.link.label}
              </a>

              {step.edge && (
                <div class="mt-4">
                  <button
                    class="inline-flex items-center gap-1.5 text-sm text-sage-dark hover:text-sage-darker font-medium bg-transparent"
                    aria-expanded="false"
                    aria-controls={`edge-content-${step.id}`}
                    data-edge-btn={step.id}
                  >
                    {step.edge.summary}
                    <svg
                      class="w-3 h-3 flex-shrink-0 transition-transform duration-200"
                      data-edge-icon={step.id}
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div id={`edge-content-${step.id}`} class="edge-panel grid" data-edge-content={step.id}>
                    <div class="overflow-hidden">
                      <p class="pt-2 text-sm text-mid-gray leading-relaxed max-w-xl">
                        {step.edge.body}
                      </p>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQBlock faqs={faqs} heading="Common Questions" />

  <CTABlock
    heading="Sent us your account details already?"
    subheading="We'll confirm everything is wired up correctly and follow up if anything's missing."
    primaryCTA="Contact Us"
    primaryHref="/get-started"
    secondaryCTA="Back to FAQ"
    secondaryHref="/faq"
  />
</BaseLayout>

<style>
  /*
   * Same grid-template-rows trick as FAQBlock: animating a real CSS property
   * with no JS-computed heights and no layout thrash, instead of a library.
   * 0fr collapses the row to zero height without display:none, so the
   * transition has something to animate between.
   */
  .edge-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .edge-panel.open {
    grid-template-rows: 1fr;
  }
  @media (prefers-reduced-motion: reduce) {
    .edge-panel {
      transition: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('[data-edge-btn]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-edge-btn');
      const panel = document.querySelector(`[data-edge-content="${id}"]`);
      const icon = document.querySelector(`[data-edge-icon="${id}"]`);
      const isOpen = panel?.classList.contains('open');

      panel?.classList.toggle('open', !isOpen);
      icon?.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQBlock from '../components/FAQBlock.astro';
import CTABlock from '../components/CTABlock.astro';
import GradientBackdrop from '../components/GradientBackdrop.astro';

const faqs = [
  {
    question: 'Is this a template that every client gets?',
    answer: 'No. Every site is built custom — unique color palette, typography, layout, and content. This example shows the architecture and quality level, but your site will look completely different. No two builds look the same.',
  },
  {
    question: 'How fast does it actually load?',
    answer: 'Test it yourself — open the site on your phone and click around. Static HTML loads instantly. No WordPress plugins, no JavaScript frameworks, no bloated page builders. Just fast, clean HTML.',
  },
  {
    question: 'What\'s the schema markup you keep mentioning?',
    answer: 'Schema markup is structured data that tells Google exactly what your site is about — your practice type, services, doctor credentials, FAQs, reviews, and more. It helps you show up in rich search results. Most agencies skip this or do it poorly. We include 7+ schema types on every page.',
  },
  {
    question: 'Can I get something like this for my practice?',
    answer: 'Yes. Head to our <a href="/get-started" class="text-sage-dark hover:text-sage-dark underline">Get Started page</a>, send us your practice info and current website, and we\'ll reach out to walk through what we\'d build for you.',
  },
];
---

<BaseLayout
  title="Example Dental Website — See What Groundwork Dental Builds"
  description="See a real dental website built by Groundwork Dental. 95+ PageSpeed, structured data on every page, built in 7 days. Click around and test it yourself."
>
  <!-- Before / After -->
  <section class="pt-10 pb-12 md:pt-12 md:pb-16 bg-white border-b border-border-light">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="section-heading mb-3">See What We Build.</h1>
        <p class="font-serif text-lg text-mid-gray">Same practice. Same doctor. Different first impression.</p>
      </div>

      <p class="font-sans text-eyebrow uppercase tracking-wide text-mid-gray mb-6 hidden md:flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-4-4m4 4l4-4" />
        </svg>
        Scroll either window — both move together
      </p>

      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 max-w-5xl mx-auto">
        <!-- center arrow -->
        <div
          class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-sage-dark text-white items-center justify-center shadow-md"
          aria-hidden="true"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M4 12h15" />
          </svg>
        </div>

        <!-- BEFORE -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="font-sans text-eyebrow uppercase tracking-wide text-mid-gray bg-surface-2 border border-border-light rounded-full px-3 py-1">Before</span>
            <span class="font-serif text-sm text-mid-gray">Their old site</span>
          </div>
          <div class="rounded-lg border border-border-light overflow-hidden bg-white">
            <div class="flex items-center gap-2 px-3 py-2 bg-surface-2 border-b border-border-light">
              <span class="w-2.5 h-2.5 rounded-full bg-border-light"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-border-light"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-border-light"></span>
              <span class="ml-2 font-sans text-[11px] text-mid-gray truncate">hbprosthodontics.com (old)</span>
            </div>
            <div class="relative">
              <div data-ba-pane class="h-[380px] md:h-[560px] overflow-hidden md:overflow-y-auto">
                <img
                  src="/images/screenshots/hb-before.png"
                  alt="Old HB Prosthodontics website — dark, dated design"
                  class="w-full block grayscale-[35%] opacity-90"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white/90 to-transparent"></div>
            </div>
          </div>
          <ul class="mt-4 space-y-2 font-serif text-sm text-mid-gray">
            <li class="flex items-start gap-2"><span class="mt-1.5 w-3 h-px bg-mid-gray/50 shrink-0"></span>DIY WordPress template</li>
            <li class="flex items-start gap-2"><span class="mt-1.5 w-3 h-px bg-mid-gray/50 shrink-0"></span>52 PageSpeed</li>
            <li class="flex items-start gap-2"><span class="mt-1.5 w-3 h-px bg-mid-gray/50 shrink-0"></span>No schema markup</li>
          </ul>
        </div>

        <!-- AFTER -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="font-sans text-eyebrow uppercase tracking-wide text-white bg-sage-dark rounded-full px-3 py-1">After</span>
            <span class="font-serif text-sm text-charcoal">What we built</span>
          </div>
          <div class="rounded-lg overflow-hidden bg-white ring-2 ring-sage-dark shadow-lg">
            <div class="flex items-center gap-2 px-3 py-2 bg-sage-tint border-b border-sage/30">
              <span class="w-2.5 h-2.5 rounded-full bg-sage/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-sage/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-sage/40"></span>
              <span class="ml-2 font-sans text-[11px] text-sage-dark truncate">hbimplants.com</span>
            </div>
            <div class="relative">
              <div data-ba-pane class="h-[380px] md:h-[560px] overflow-hidden md:overflow-y-auto">
                <img
                  src="/images/screenshots/hb-after.png"
                  alt="New hbimplants.com — modern, fast, custom design"
                  class="w-full block"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white/90 to-transparent"></div>
            </div>
          </div>
          <ul class="mt-4 space-y-2 font-serif text-sm text-charcoal">
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Custom design</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 95+ PageSpeed</li>
            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-sage-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Built in 7 days — you own everything</li>
          </ul>
        </div>
      </div>

      <div class="mt-10">
        <p class="font-serif text-sm text-mid-gray mb-4">A real site for a real practice, not a mockup, not a demo, not a Figma file.</p>
        <a
          href="https://hbimplants.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary px-8 py-3 inline-flex items-center gap-2"
        >
          Visit the live site
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-10 relative isolate bg-surface-2">
    <GradientBackdrop intensity={0.68} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="card">
          <p class="text-4xl text-sage-dark font-mono mb-1">95+</p>
          <p class="font-sans text-eyebrow uppercase text-mid-gray">PageSpeed Score</p>
        </div>
        <div class="card">
          <p class="text-4xl text-charcoal font-mono mb-1">7</p>
          <p class="font-sans text-eyebrow uppercase text-mid-gray">Service Categories</p>
        </div>
        <div class="card">
          <p class="text-4xl text-charcoal font-mono mb-1">7+</p>
          <p class="font-sans text-eyebrow uppercase text-mid-gray">Schema Types</p>
        </div>
        <div class="card">
          <p class="text-4xl text-charcoal font-mono mb-1">7</p>
          <p class="font-sans text-eyebrow uppercase text-mid-gray">Days to Build</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Under the Hood -->
  <section class="py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-subheading mb-12">What's Under the Hood</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div>
          <h3 class="font-serif text-charcoal mb-3">Site Architecture</h3>
          <ul class="font-serif text-mid-gray text-sm space-y-2">
            <li>Homepage (authority hub)</li>
            <li>About / Doctor bio with credentials</li>
            <li>6 service hub pages with sub-pages</li>
            <li>Before & after gallery with lightbox</li>
            <li>Resources section with 10+ authority articles</li>
            <li>FAQ page with accordion + schema</li>
            <li>Financing & insurance information</li>
            <li>Links to your existing booking system</li>
            <li>Location pages for nearby cities</li>
            <li>Services directory</li>
          </ul>
        </div>
        <div>
          <h3 class="font-serif text-charcoal mb-3">Technical Stack</h3>
          <ul class="font-serif text-mid-gray text-sm space-y-2">
            <li><strong class="text-charcoal">Framework:</strong> Astro v5 (static site generation)</li>
            <li><strong class="text-charcoal">Styling:</strong> Tailwind CSS with custom design tokens</li>
            <li><strong class="text-charcoal">Hosting:</strong> Cloudflare Pages (free, global CDN)</li>
            <li><strong class="text-charcoal">JavaScript:</strong> Zero by default (only FAQ accordion)</li>
            <li><strong class="text-charcoal">Images:</strong> WebP, lazy-loaded, optimized</li>
            <li><strong class="text-charcoal">Forms:</strong> Linked to your existing booking/patient management</li>
            <li><strong class="text-charcoal">Analytics:</strong> Google Analytics 4</li>
            <li><strong class="text-charcoal">Search:</strong> Google Search Console verified</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema Detail -->
  <section class="py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="section-subheading mb-4">Schema Markup on Every Page</h2>
        <p class="text-mid-gray mb-8">
          Most dental websites have zero structured data. This site has 7+ schema types telling Google exactly what the practice offers.
        </p>
        <div class="bg-charcoal rounded p-6 overflow-x-auto">
          <pre class="text-sm text-green-400 font-mono leading-relaxed"><code>{`// Every page includes:
LocalBusiness    → Practice name, address, phone, hours
BreadcrumbList   → Auto-generated navigation trail
FAQPage          → Every FAQ section (rich results)

// Service pages add:
MedicalProcedure → Treatment details, description

// Resource articles add:
BlogPosting      → Article schema with author, date

// Doctor pages add:
Physician        → Credentials, specialties, affiliations

// Homepage adds:
AggregateRating  → Overall review score from Google`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Test It Yourself -->
  <section class="py-10 relative isolate bg-surface-2">
    <GradientBackdrop intensity={0.68} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="section-subheading mb-4">Test It Yourself</h2>
        <p class="text-mid-gray mb-8">Don't take our word for it. Run these yourself.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="https://pagespeed.web.dev/analysis/https-hbimplants-com/random"
            target="_blank"
            rel="noopener noreferrer"
            class="card hover:border-sage transition-colors text-center"
          >
            <p class="font-serif text-charcoal mb-1">PageSpeed Insights</p>
            <p class="font-serif text-sm text-mid-gray">Check load speed and Core Web Vitals</p>
          </a>
          <a
            href="https://search.google.com/test/rich-results?url=https://hbimplants.com"
            target="_blank"
            rel="noopener noreferrer"
            class="card hover:border-sage transition-colors text-center"
          >
            <p class="font-serif text-charcoal mb-1">Rich Results Test</p>
            <p class="font-serif text-sm text-mid-gray">Verify schema markup</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <FAQBlock faqs={faqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <CTABlock variant="warm" />
    </div>
  </section>

  <script is:inline>
    (() => {
      const panes = document.querySelectorAll('[data-ba-pane]');
      if (panes.length !== 2) return;
      let lock = false;
      panes.forEach((pane, i) => {
        const other = panes[1 - i];
        pane.addEventListener('scroll', () => {
          if (lock) return;
          lock = true;
          const max = pane.scrollHeight - pane.clientHeight;
          const otherMax = other.scrollHeight - other.clientHeight;
          other.scrollTop = max > 0 ? (pane.scrollTop / max) * otherMax : 0;
          requestAnimationFrame(() => { lock = false; });
        }, { passive: true });
      });
    })();
  </script>
</BaseLayout>

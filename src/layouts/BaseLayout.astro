---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, organizationSchema } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  articleAuthor?: string;
  articleDate?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/branding/og-default.jpg',
  ogType = 'website',
  articleAuthor,
  articleDate,
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
// Single source: PUBLIC_GA4_MEASUREMENT_ID, declared in wrangler.toml [vars]
// and loaded into local builds by scripts/build.mjs, so a local build and a
// Cloudflare build render the same tag.
//
// A placeholder-shaped id is rejected rather than rendered. A tag pointing at
// G-XXXXXXXXXX records nothing while looking installed — that exact value
// shipped on a client site and was then reported to a prospect as working
// analytics. Absent is honest; a convincing fake is not.
const ga4Raw = String(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '');
const ga4Id = /^G-[A-Z0-9]+$/.test(ga4Raw) && !/^G-X+$/i.test(ga4Raw) ? ga4Raw : '';

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Auto-generate BreadcrumbList from URL path
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': site.url,
    },
    ...pathSegments.map((seg, i) => ({
      '@type': 'ListItem',
      'position': i + 2,
      'name': seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
      'item': `${site.url}/${pathSegments.slice(0, i + 1).join('/')}`,
    })),
  ],
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {articleAuthor && <meta name="author" content={articleAuthor} />}
    {articleDate && <meta name="date" content={articleDate} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Georgia (system serif) + Figtree (Google Fonts, humanist sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Google Analytics 4 -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          // Assigned to window deliberately. Astro wraps a define:vars script
          // in an IIFE, so a bare `function gtag(){}` is trapped in that
          // closure and window.gtag stays undefined. Page scripts are
          // separate modules, so their `typeof gtag === 'function'` guard
          // silently fails and their events never fire — which is exactly
          // what happened to the two lead events on this site.
          window.gtag = function gtag(){ window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ga4Id);

          // Site-wide conversion signals.
          //
          // Pageviews alone cannot answer the only question that matters here
          // — whether a visitor did something. These are delegated listeners
          // on document, so they cover links rendered after load and need no
          // per-page wiring.
          //
          // The lead form is NOT tracked here: it submits by fetch, so the
          // only honest place to record it is after the request succeeds.
          // See get-started.astro.

          // The checklist is the soft conversion — the visitor who is not
          // ready to request a preview but is willing to be known.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href*="/checklist"]');
            if (!link) return;
            gtag('event', 'checklist_view', {
              page_path: window.location.pathname,
              href: link.getAttribute('href'),
            });
          });

          // Downloading the PDF is a stronger signal than viewing the page.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href$=".pdf"]');
            if (!link) return;
            gtag('event', 'checklist_download', {
              page_path: window.location.pathname,
            });
          });

          // Someone emailing us directly instead of using the form is still a
          // lead; it just never touches the database.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href^="mailto:"]');
            if (!link) return;
            gtag('event', 'email_click', {
              page_path: window.location.pathname,
            });
          });

          // Viewing the example site is the strongest intent signal short of
          // submitting — it is what a prospect checks before deciding.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href*="/example"]');
            if (!link) return;
            gtag('event', 'example_view', {
              page_path: window.location.pathname,
            });
          });
        </script>
      </>
    )}
    <ClientRouter />

    <script is:inline>
      // Set before first paint, so revealed content is never painted visible
      // and then hidden. Skipped entirely under reduced motion — those readers
      // get the page with no hidden state at all, rather than an instant
      // version of the animation.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
        // Failsafe. This script hides content that a *separate* bundled script
        // is responsible for revealing. If that script never runs — blocked,
        // failed to load, threw — the page would stay blank forever. So drop
        // the hiding class after 3s unless the observer cancels this first.
        window.__revealFailsafe = window.setTimeout(function () {
          document.documentElement.classList.remove('js-reveal');
        }, 3000);
      }
    </script>
  </head>
  <body class="bg-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-charcoal focus:text-white focus:text-sm focus:font-sans focus:rounded">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  
<script>
  /**
   * Reveals .reveal / .reveal-row once, as they enter the viewport.
   *
   * One-shot on purpose: re-animating on the way back up turns a scroll into
   * a flicker. Elements already in view when this runs simply animate
   * immediately, which gives the page a settle on load.
   */
  function initReveal() {
    if (!document.documentElement.classList.contains('js-reveal')) return;
    // We are alive, so the failsafe is not needed.
    clearTimeout((window as any).__revealFailsafe);

    const els = document.querySelectorAll<HTMLElement>(
      '.reveal:not([data-revealed]), .reveal-row:not([data-revealed])'
    );
    if (!els.length) return;

    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => { el.dataset.revealed = ''; });
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.revealed = '';
          io.unobserve(entry.target);
        }
      },
      // Start slightly before the band is fully in view, so it is settled by
      // the time the reader's eye reaches it.
      { rootMargin: '0px 0px -8% 0px', threshold: 0.01 }
    );

    els.forEach((el) => io.observe(el));
  }

  initReveal();
  document.addEventListener('astro:page-load', initReveal);

  // The router swaps <html>'s attributes for the incoming document's, which
  // never carries the runtime-added class — so without this the reveal
  // silently stops working after the first client-side navigation. Setting it
  // on the incoming document applies it before the new page paints, so there
  // is no visible flash.
  document.addEventListener('astro:before-swap', (e) => {
    if (document.documentElement.classList.contains('js-reveal')) {
      (e as any).newDocument.documentElement.classList.add('js-reveal');
    }
  });
</script>
</body>
</html>

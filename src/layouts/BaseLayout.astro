---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, organizationSchema } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  articleAuthor?: string;
  articleDate?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/branding/og-default.jpg',
  ogType = 'website',
  articleAuthor,
  articleDate,
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
// Single source: PUBLIC_GA4_MEASUREMENT_ID, declared in wrangler.toml [vars]
// and loaded into local builds by scripts/build.mjs, so a local build and a
// Cloudflare build render the same tag.
//
// A placeholder-shaped id is rejected rather than rendered. A tag pointing at
// G-XXXXXXXXXX records nothing while looking installed — that exact value
// shipped on a client site and was then reported to a prospect as working
// analytics. Absent is honest; a convincing fake is not.
const ga4Raw = String(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '');
const ga4Id = /^G-[A-Z0-9]+$/.test(ga4Raw) && !/^G-X+$/i.test(ga4Raw) ? ga4Raw : '';

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Auto-generate BreadcrumbList from URL path
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': site.url,
    },
    ...pathSegments.map((seg, i) => ({
      '@type': 'ListItem',
      'position': i + 2,
      'name': seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
      'item': `${site.url}/${pathSegments.slice(0, i + 1).join('/')}`,
    })),
  ],
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {articleAuthor && <meta name="author" content={articleAuthor} />}
    {articleDate && <meta name="date" content={articleDate} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Georgia (system serif) + Figtree (Google Fonts, humanist sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Google Analytics 4 -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          // Assigned to window deliberately. Astro wraps a define:vars script
          // in an IIFE, so a bare `function gtag(){}` is trapped in that
          // closure and window.gtag stays undefined. Page scripts are
          // separate modules, so their `typeof gtag === 'function'` guard
          // silently fails and their events never fire — which is exactly
          // what happened to the two lead events on this site.
          window.gtag = function gtag(){ window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ga4Id);

          // Site-wide conversion signals.
          //
          // Pageviews alone cannot answer the only question that matters here
          // — whether a visitor did something. These are delegated listeners
          // on document, so they cover links rendered after load and need no
          // per-page wiring.
          //
          // The lead form is NOT tracked here: it submits by fetch, so the
          // only honest place to record it is after the request succeeds.
          // See get-started.astro.

          // The checklist is the soft conversion — the visitor who is not
          // ready to request a preview but is willing to be known.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href*="/checklist"]');
            if (!link) return;
            gtag('event', 'checklist_view', {
              page_path: window.location.pathname,
              href: link.getAttribute('href'),
            });
          });

          // Downloading the PDF is a stronger signal than viewing the page.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href$=".pdf"]');
            if (!link) return;
            gtag('event', 'checklist_download', {
              page_path: window.location.pathname,
            });
          });

          // Someone emailing us directly instead of using the form is still a
          // lead; it just never touches the database.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href^="mailto:"]');
            if (!link) return;
            gtag('event', 'email_click', {
              page_path: window.location.pathname,
            });
          });

          // Viewing the example site is the strongest intent signal short of
          // submitting — it is what a prospect checks before deciding.
          document.addEventListener('click', (event) => {
            const link = event.target.closest('a[href*="/example"]');
            if (!link) return;
            gtag('event', 'example_view', {
              page_path: window.location.pathname,
            });
          });
        </script>
      </>
    )}
    <ClientRouter />

  </head>
  <body class="bg-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-charcoal focus:text-white focus:text-sm focus:font-sans focus:rounded">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  
<script>
  /**
   * Scroll reveal — component level.
   *
   * A .reveal section is a marker meaning "animate my contents", not "animate
   * me". Hiding the section itself would fade its background in and leave a
   * blank band while the reader scrolls toward it.
   *
   * Only elements starting below the fold are hidden, so nothing the reader
   * can already see is ever touched — which is what keeps LCP off this code
   * path, and what makes it safe to run after first paint.
   */

  // The things worth animating on their own: a heading, a paragraph, a card,
  // a button, a grid cell. Deliberately not wrappers or layout divs.
  const COMPONENTS = [
    'h1', 'h2', 'h3', 'p', 'ul', 'ol', 'table', 'form', 'img', 'blockquote',
    '.card', '.prose-card', '.btn-primary', '.btn-secondary', '.btn-dark',
    "[class*='grid'] > *",
  ].join(',');

  function componentsIn(section: Element): HTMLElement[] {
    const found = [...section.querySelectorAll<HTMLElement>(COMPONENTS)];
    const set = new Set(found);
    // Keep only the outermost match, so a <p> inside an animating card does
    // not animate separately from the card.
    return found.filter((el) => {
      for (let p = el.parentElement; p && p !== section; p = p.parentElement) {
        if (set.has(p)) return false;
      }
      return true;
    });
  }

  function markAndObserve() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const fold = window.innerHeight * 0.85;
    const hidden: HTMLElement[] = [];

    const consider = (el: HTMLElement, delayIndex: number) => {
      if (el.hasAttribute('data-reveal-hidden') || el.hasAttribute('data-revealed')) return;
      if (el.getBoundingClientRect().top <= fold) return; // visible already — leave alone
      el.setAttribute('data-reveal-hidden', '');
      // Only matters for components that enter together, e.g. a row of cards.
      if (delayIndex) el.style.setProperty('--reveal-delay', Math.min(delayIndex, 4) * 70 + 'ms');
      hidden.push(el);
    };

    document.querySelectorAll<HTMLElement>('.reveal').forEach((section) => {
      componentsIn(section).forEach((el, i) => consider(el, i));
    });
    document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((g) => consider(g, 0));

    if (!hidden.length) return;

    const revealNow = (el: HTMLElement) => {
      el.dataset.revealed = '';
      el.querySelectorAll<HTMLElement>('.reveal-row').forEach((row) => {
        row.dataset.revealed = '';
      });
    };

    if (!('IntersectionObserver' in window)) {
      hidden.forEach(revealNow);
      return;
    }

    // If anything below throws, un-hide rather than leave content invisible.
    const failsafe = window.setTimeout(() => hidden.forEach(revealNow), 3000);

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          revealNow(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      // Fires once the element's top is ~78% down the screen. Tighter than the
      // section-level version was, because a single component is much shorter
      // than a band and would otherwise animate well before it is looked at.
      { rootMargin: '0px 0px -22% 0px', threshold: 0 }
    );

    hidden.forEach((el) => io.observe(el));
    clearTimeout(failsafe);
  }

  markAndObserve();
  document.addEventListener('astro:page-load', markAndObserve);

  /**
   * Record navigation direction so the page transition can reverse on back.
   * The router knows the direction but never exposes it to CSS.
   *
   * The direction is only available at before-preparation, but the swap then
   * replaces <html>'s attributes with the incoming document's — so setting it
   * there gets wiped before the transition runs. Stash it, then write it onto
   * the incoming document at swap time.
   */
  let navDirection = 'forward';

  document.addEventListener('astro:before-preparation', (e) => {
    navDirection = (e as any).direction === 'back' ? 'back' : 'forward';
  });

  document.addEventListener('astro:before-swap', (e) => {
    (e as any).newDocument.documentElement.dataset.nav = navDirection;
  });
</script>
</body>
</html>
